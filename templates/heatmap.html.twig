{% extends 'base.html.twig' %}

{% block title %}Heatmap – {{ identifier }}{% endblock %}

{% block body %}
    <div id="map"
         data-controller="heatmap"
         data-heatmap-identifier-value="{{ identifier }}"
         data-heatmap-center-lon-value="{{ centerLon }}"
         data-heatmap-center-lat-value="{{ centerLat }}"
         data-heatmap-zoom-value="{{ zoom }}"></div>
{% endblock %}
