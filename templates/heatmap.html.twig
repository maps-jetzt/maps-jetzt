{% extends 'base.html.twig' %}

{% block title %}Heatmap – {{ identifier }}{% endblock %}

{% block navbar %}
    <select id="color-scheme" class="form-select form-select-sm bg-dark text-light border-secondary ms-auto" style="width: auto;">
        <option value="fire">Fire</option>
        <option value="blue">Blue</option>
        <option value="purple">Purple</option>
        <option value="green">Green</option>
    </select>
{% endblock %}

{% block body %}
    <div id="map"
         data-controller="heatmap"
         data-heatmap-identifier-value="{{ identifier }}"
         data-heatmap-center-lon-value="{{ centerLon }}"
         data-heatmap-center-lat-value="{{ centerLat }}"
         data-heatmap-zoom-value="{{ zoom }}"></div>
{% endblock %}
