<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}maps.jetzt{% endblock %}</title>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body>
<nav class="navbar navbar-dark bg-dark navbar-expand-lg">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">maps.jetzt</a>
        {% block navbar %}{% endblock %}
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#impressumModal">Impressum</a>
            </li>
        </ul>
    </div>
</nav>

<div class="modal fade" id="impressumModal" tabindex="-1" aria-labelledby="impressumModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="impressumModalLabel">Impressum</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <div class="modal-body">
                <h6>Angaben gemäß § 5 DDG</h6>
                <p>
                    Malte Hübner<br>
                    Goethestraße 48<br>
                    21335 Lüneburg
                </p>

                <h6>Kontakt</h6>
                <p>
                    Telefon: 04131 7073376<br>
                    E-Mail: maltehuebner@gmx.org
                </p>

                <h6>Verantwortlich für den Inhalt gemäß § 18 Abs. 2 MStV</h6>
                <p>
                    Malte Hübner<br>
                    Goethestraße 48<br>
                    21335 Lüneburg
                </p>
            </div>
        </div>
    </div>
</div>

{% block body %}{% endblock %}
</body>
</html>
